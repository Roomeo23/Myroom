        <!-- Gravel Bedding Pattern -->
        <pattern id="pat_gravel" width="16" height="16" patternUnits="userSpaceOnUse">
          <polygon points="3,3 6,1 7,5" fill="none" stroke="#ffffff" stroke-width="0.8" opacity="0.4"/>
