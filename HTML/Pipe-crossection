  <div id="toastContainer" class="fixed bottom-16 right-6 z-50 flex flex-col space-y-2 pointer-events-none"></div>

  <!-- MAIN JAVASCRIPT LOGIC -->
  <script>
    // --- Application State ---
    let currentShape = 'circular'; // 'circular' or 'box'
    let syncMode = 'cover'; // 'cover' (H_cover drives Z_crown & Z_invert), 'crown' (Z_crown drives H_cover & Z_invert), or 'invert' (Z_invert drives Z_crown & H_cover)
    let zoomLevel = 1.0;
    let panX = 0;
    let panY = 0;
    let isDragging = false;
    let dragStartX = 0;
    let dragStartY = 0;

    // Default Soil Layers
    let soilLayers = [
      { id: 1, name: 'ชั้นดินถม / ผิวทาง (Top Fill)', thickness: 0.80, color: '#475569', pattern: 'asphalt' },
      { id: 2, name: 'ชั้นดินเหนียวอ่อน (Soft Clay)', thickness: 2.20, color: '#78350f', pattern: 'soft_clay' },
      { id: 3, name: 'ชั้นทรายปนดินเหนียว (Clayey Sand)', thickness: 3.00, color: '#92400e', pattern: 'sand' },
      { id: 4, name: 'ชั้นดินเหนียวแข็ง (Stiff Clay)', thickness: 4.00, color: '#334155', pattern: 'stiff_clay' }
    ];

    // Presets Configurations
    const presets = {
      drainage_twin: {
        groundEl: 10.00,
        pipeCrownEl: 8.20,
        shape: 'circular',
        innerDiameter: 1.20,
        wallThick: 0.12,
        numPipes: 2,
        pipeSpacing: 0.50,
        beddingThick: 0.15,
        beddingType: 'sand',
        waterLevelPct: 45,
        soilLayers: [
          { id: 1, name: 'ชั้นโครงสร้างทาง (Road Base)', thickness: 0.60, color: '#475569', pattern: 'asphalt' },
          { id: 2, name: 'ชั้นดินเหนียวอ่อน (Soft Clay)', thickness: 2.50, color: '#78350f', pattern: 'soft_clay' },
          { id: 3, name: 'ชั้นดินเหนียวแข็ง (Stiff Clay)', thickness: 4.00, color: '#334155', pattern: 'stiff_clay' }
        ]
      },
      box_culvert_triple: {
        groundEl: 12.50,
        pipeCrownEl: 9.80,
        shape: 'box',
        boxWidth: 2.50,
        boxHeight: 2.00,
        wallThickBox: 0.25,
        numPipes: 3,
        pipeSpacing: 0.60,
        beddingThick: 0.20,
        beddingType: 'concrete',
        waterLevelPct: 60,
        soilLayers: [
          { id: 1, name: 'ชั้นดินถมคันทาง (Embankment Fill)', thickness: 1.50, color: '#64748b', pattern: 'asphalt' },
          { id: 2, name: 'ชั้นดินตะกอน (Alluvial Soil)', thickness: 3.50, color: '#78350f', pattern: 'soft_clay' },
          { id: 3, name: 'ชั้นทรายแน่น (Dense Sand)', thickness: 4.00, color: '#92400e', pattern: 'sand' }
        ]
      },
      single_pipe_deep: {
        groundEl: 15.00,
        pipeCrownEl: 9.50,
        shape: 'circular',
        innerDiameter: 1.50,
        wallThick: 0.15,
        numPipes: 1,
        pipeSpacing: 0.50,
        beddingThick: 0.20,
        beddingType: 'gravel',
        waterLevelPct: 35,
        soilLayers: [
          { id: 1, name: 'ชั้นดินถมผิวดิน (Topsoil)', thickness: 1.00, color: '#475569', pattern: 'asphalt' },
          { id: 2, name: 'ชั้นดินเหนียวปนทราย (Sandy Clay)', thickness: 4.00, color: '#78350f', pattern: 'soft_clay' },
          { id: 3, name: 'ชั้นดินเหนียวแข็ง (Stiff Clay)', thickness: 6.00, color: '#1e293b', pattern: 'stiff_clay' }
        ]
      }
    };

    function setPipeShape(shape) {
      currentShape = shape === 'box' ? 'box' : 'circular';
      const btnCircle = document.getElementById('btnShapeCircle');
      const btnBox = document.getElementById('btnShapeBox');
      const circularInputs = document.getElementById('circularInputs');
      const boxInputs = document.getElementById('boxInputs');

      const activeBtnClass = 'px-3 py-1.5 text-xs rounded-lg border flex items-center justify-center space-x-2 transition bg-blue-600 text-white border-blue-500';
      const inactiveBtnClass = 'px-3 py-1.5 text-xs rounded-lg border flex items-center justify-center space-x-2 transition bg-slate-800 text-slate-300 border-slate-600 hover:bg-slate-700';

      if (btnCircle) btnCircle.className = currentShape === 'circular' ? activeBtnClass : inactiveBtnClass;
      if (btnBox) btnBox.className = currentShape === 'box' ? activeBtnClass : inactiveBtnClass;
      if (circularInputs) circularInputs.classList.toggle('hidden', currentShape !== 'circular');
      if (boxInputs) boxInputs.classList.toggle('hidden', currentShape !== 'box');

      if (syncMode === 'invert') {
        syncLinkedValuesFromActiveMode();
      }
      updateDraw();
    }

    // --- 2-Way / 3-Way Sync Mode & Input Handlers for Cover & Elevations ---
    function getDecimalsFromStr(str) {
      if (!str || typeof str !== 'string') return 2;
      const trimmed = str.trim();
      if (!trimmed.includes('.')) return 0;
      const frac = trimmed.split('.')[1].replace(/0+$/, '');
      return Math.min(Math.max(frac.length, 2), 6);
    }

    function getActiveElevationDecimals() {
      const gStr = document.getElementById('groundEl').value;
      const cStr = document.getElementById('coverDepthInput').value;
      const pStr = document.getElementById('pipeCrownEl').value;
      const iStr = document.getElementById('pipeInvertEl') ? document.getElementById('pipeInvertEl').value : '';
      return Math.max(
        getDecimalsFromStr(gStr),
        getDecimalsFromStr(cStr),
        getDecimalsFromStr(pStr),
        getDecimalsFromStr(iStr),
        2
      );
    }

    function getCurrentOuterPipeHeight() {
      if (currentShape === 'circular') {
        const innerW = parseFloat(document.getElementById('innerDiameter').value) || 1.2;
        const wallThick = parseFloat(document.getElementById('wallThickCircle').value) || 0.12;
        return innerW + 2 * wallThick;
      } else {
        const innerH = parseFloat(document.getElementById('boxHeight').value) || 1.5;
        const wallThick = parseFloat(document.getElementById('wallThickBox').value) || 0.2;
        return innerH + 2 * wallThick;
      }
    }

    function getCurrentInnerHeightAndWall() {
      if (currentShape === 'circular') {
        const innerH = parseFloat(document.getElementById('innerDiameter').value) || 1.2;
        const wallThick = parseFloat(document.getElementById('wallThickCircle').value) || 0.12;
        return { innerH, wallThick, outerH: innerH + 2 * wallThick };
      } else {
        const innerH = parseFloat(document.getElementById('boxHeight').value) || 1.5;
        const wallThick = parseFloat(document.getElementById('wallThickBox').value) || 0.2;
        return { innerH, wallThick, outerH: innerH + 2 * wallThick };
      }
    }

    function formatElevationVal(val, decimals = null) {
      const dec = decimals !== null ? decimals : getActiveElevationDecimals();
      const num = Number(val);
      if (isNaN(num)) return '0.00';
      return num.toFixed(dec);
    }

    function syncLinkedValuesFromActiveMode() {
      const groundEl = parseFloat(document.getElementById('groundEl').value) || 10.0;
      const elevDec = getActiveElevationDecimals();
      const { innerH, wallThick, outerH } = getCurrentInnerHeightAndWall();
      const pipeSpanH = wallThick + innerH; // ความหนาท่อ + ความสูงหรือเส้นผ่านศูนย์กลางท่อ
      const crownInputEl = document.getElementById('pipeCrownEl');
      const coverInputEl = document.getElementById('coverDepthInput');
      const invertInputEl = document.getElementById('pipeInvertEl');

      let pipeCrownEl = parseFloat(crownInputEl.value);
      if (isNaN(pipeCrownEl)) pipeCrownEl = groundEl - 2.5;

      let coverDepth = parseFloat(coverInputEl.value);
      if (isNaN(coverDepth)) coverDepth = groundEl - pipeCrownEl;

      let pipeInvertEl = invertInputEl ? parseFloat(invertInputEl.value) : (groundEl - coverDepth - pipeSpanH);
      if (isNaN(pipeInvertEl)) pipeInvertEl = groundEl - coverDepth - pipeSpanH;

      if (syncMode === 'cover') {
        // โหมด 1: ล็อกดินถม (Z_ground = input, ดินถม = input)
        // หลังท่อ = Z_ground - ดินถม
        // ท้องท่อ = Z_ground - ดินถม - ความหนาท่อ - ความสูงหรือเส้นผ่านศูนย์กลางท่อ
        pipeCrownEl = groundEl - coverDepth;
        pipeInvertEl = groundEl - coverDepth - wallThick - innerH;
        crownInputEl.value = formatElevationVal(pipeCrownEl, elevDec);
        if (invertInputEl) invertInputEl.value = formatElevationVal(pipeInvertEl, elevDec);
      } else if (syncMode === 'crown') {
        // โหมด 2: ล็อกระดับหลังท่อ (Z_ground = input, หลังท่อ = input)
        // ดินถม = Z_ground - หลังท่อ
        // ท้องท่อ = หลังท่อ - ความหนาท่อ - ความสูงหรือเส้นผ่านศูนย์กลางท่อ
        coverDepth = groundEl - pipeCrownEl;
        pipeInvertEl = pipeCrownEl - wallThick - innerH;
        coverInputEl.value = formatElevationVal(coverDepth, elevDec);
        if (invertInputEl) invertInputEl.value = formatElevationVal(pipeInvertEl, elevDec);
      } else if (syncMode === 'invert') {
        // โหมด 3: ล็อกระดับท้องท่อ (Z_ground = input, ท้องท่อ = input)
        // หลังท่อ = ท้องท่อ + ความหนาท่อ + ความสูงหรือเส้นผ่านศูนย์กลางท่อ
        // ดินถม = Z_ground - หลังท่อ
        pipeCrownEl = pipeInvertEl + wallThick + innerH;
        coverDepth = groundEl - pipeCrownEl;
        crownInputEl.value = formatElevationVal(pipeCrownEl, elevDec);
        coverInputEl.value = formatElevationVal(coverDepth, elevDec);
      }
    }

    function handleGroundInput() {
      syncLinkedValuesFromActiveMode();
      updateDraw();
    }

    function setSyncMode(mode) {
      if (mode === 'crown') syncMode = 'crown';
      else if (mode === 'invert') syncMode = 'invert';
      else syncMode = 'cover';

      const btnCover = document.getElementById('btnSyncCover');
      const btnCrown = document.getElementById('btnSyncCrown');
      const btnInvert = document.getElementById('btnSyncInvert');
      const notice = document.getElementById('syncStatusNotice');

      const boxCover = document.getElementById('boxCoverField');
      const boxCrown = document.getElementById('boxCrownField');
      const boxInvert = document.getElementById('boxInvertField');
      const lblCover = document.getElementById('lblCoverField');
      const lblCrown = document.getElementById('lblCrownField');
      const lblInvert = document.getElementById('lblInvertField');

      const activeClass = "px-2 py-1 rounded transition text-xs bg-blue-600 text-white font-medium";
      const inactiveClass = "px-2 py-1 rounded transition text-xs bg-slate-700 text-slate-300 hover:bg-slate-600";

      if (btnCover) btnCover.className = syncMode === 'cover' ? activeClass : inactiveClass;
      if (btnCrown) btnCrown.className = syncMode === 'crown' ? activeClass : inactiveClass;
      if (btnInvert) btnInvert.className = syncMode === 'invert' ? activeClass : inactiveClass;

      // ไฮไลต์ตัวแปรรองที่ถูกควบคุมในโหมดนั้น และระบุช่องที่แปรผันตามผิวดิน (Z_ground)
      const lockedBox = "flex items-center bg-slate-800 border-2 border-cyan-400/80 rounded-lg focus-within:ring-2 focus-within:ring-cyan-400 overflow-hidden transition";
      const derivedBox = "flex items-center bg-slate-900/70 border border-slate-700/80 rounded-lg focus-within:ring-2 focus-within:ring-blue-500 overflow-hidden transition";

      if (boxCover && boxCrown && boxInvert) {
        boxCover.className = syncMode === 'cover' ? lockedBox : derivedBox;
        boxCrown.className = syncMode === 'crown' ? lockedBox : derivedBox;
        boxInvert.className = syncMode === 'invert' ? lockedBox : derivedBox;
      }

      if (lblCover) {
        lblCover.innerHTML = syncMode === 'cover'
          ? 'ดินถม <span class="text-[9px] text-cyan-400">(ตัวแปรล็อก)</span>'
          : 'ดินถม <span class="text-[9px] text-slate-400">(แปรผันตาม Z_ground)</span>';
      }
      if (lblCrown) {
        lblCrown.innerHTML = syncMode === 'crown'
          ? 'หลังท่อ <span class="text-[9px] text-cyan-400">(ตัวแปรล็อก)</span>'
          : 'หลังท่อ <span class="text-[9px] text-slate-400">(แปรผันตาม Z_ground)</span>';
      }
      if (lblInvert) {
        lblInvert.innerHTML = syncMode === 'invert'
          ? 'ท้องท่อ <span class="text-[9px] text-cyan-400">(ตัวแปรล็อก)</span>'
          : 'ท้องท่อ <span class="text-[9px] text-slate-400">(แปรผันตาม Z_ground)</span>';
      }

      if (notice) {
        let formulaText = 'ล็อกดินถม: หลังท่อ = Z_ground - ดินถม | ท้องท่อ = Z_ground - ดินถม - t - H/D';
        if (syncMode === 'crown') {
          formulaText = 'ล็อกหลังท่อ: ดินถม = Z_ground - หลังท่อ | ท้องท่อ = หลังท่อ - t - H/D';
        } else if (syncMode === 'invert') {
          formulaText = 'ล็อกท้องท่อ: หลังท่อ = ท้องท่อ + t + H/D | ดินถม = Z_ground - หลังท่อ';
        }
        notice.innerHTML = `<span><i class="fa-solid fa-calculator mr-1"></i>${formulaText}</span><span class="font-mono text-slate-300">Auto Sync Active</span>`;
      }

      syncLinkedValuesFromActiveMode();
      updateDraw();
    }

    function handleCoverInput() {
      setSyncMode('cover');
      syncLinkedValuesFromActiveMode();
      updateDraw();
    }

    function handleCrownInput() {
      setSyncMode('crown');
      syncLinkedValuesFromActiveMode();
      updateDraw();
    }

    function handleInvertInput() {
      setSyncMode('invert');
      syncLinkedValuesFromActiveMode();
      updateDraw();
    }

    function handlePipeSizeChange() {
      if (syncMode === 'invert') {
        syncLinkedValuesFromActiveMode();
      }
      updateDraw();
    }

    // --- Soil Layers List Management ---
    function renderSoilLayersList() {
      const container = document.getElementById('soilLayersList');
      container.innerHTML = '';

      soilLayers.forEach((layer, index) => {
        const item = document.createElement('div');
        item.className = 'bg-slate-800 p-2.5 rounded-lg border border-slate-700 space-y-2';
        item.innerHTML = `
          <div class="flex items-center justify-between gap-2">
            <span class="text-[11px] font-bold text-slate-400 font-mono">#${index + 1}</span>
            <input type="text" value="${layer.name}" onchange="updateSoilLayer(${index}, 'name', this.value)" class="flex-1 bg-slate-900 text-white text-xs border border-slate-700 rounded px-2 py-1 focus:outline-none focus:border-blue-500">
            <button onclick="removeSoilLayer(${index})" class="text-slate-500 hover:text-rose-400 p-1 transition" title="ลบชั้นดิน">
              <i class="fa-solid fa-trash-can text-xs"></i>
            </button>
          </div>
          <div class="grid grid-cols-3 gap-2 text-xs">
            <div>
              <span class="text-[10px] text-slate-400 block mb-0.5">หนา (ม.)</span>
              <input type="number" value="${layer.thickness}" step="0.1" min="0.1" onchange="updateSoilLayer(${index}, 'thickness', parseFloat(this.value))" class="w-full bg-slate-900 text-white border border-slate-700 rounded px-1.5 py-0.5 text-xs">
            </div>
            <div>
              <span class="text-[10px] text-slate-400 block mb-0.5">สีชั้นดิน</span>
              <input type="color" value="${layer.color}" onchange="updateSoilLayer(${index}, 'color', this.value)" class="w-full h-7 bg-slate-900 border border-slate-700 rounded p-0.5 cursor-pointer">
            </div>
            <div>
              <span class="text-[10px] text-slate-400 block mb-0.5">ลวดลาย</span>
              <select onchange="updateSoilLayer(${index}, 'pattern', this.value)" class="w-full bg-slate-900 text-white border border-slate-700 rounded px-1 py-1 text-[11px]">
                <option value="asphalt" ${layer.pattern==='asphalt'?'selected':''}>เฉียงถี่ (Asphalt/Fill)</option>
                <option value="soft_clay" ${layer.pattern==='soft_clay'?'selected':''}>เส้นแนวนอน (Clay)</option>
                <option value="sand" ${layer.pattern==='sand'?'selected':''}>จุดทราย (Sand)</option>
                <option value="stiff_clay" ${layer.pattern==='stiff_clay'?'selected':''}>ตาข่าย (Stiff Clay)</option>
              </select>
            </div>
          </div>
        `;
        container.appendChild(item);
      });
    }

    function addSoilLayer() {
      const newId = soilLayers.length + 1;
      soilLayers.push({
        id: newId,
        name: `ชั้นดินใหม่ ${newId}`,
        thickness: 1.50,
        color: '#475569',
        pattern: 'sand'
      });
      renderSoilLayersList();
      updateDraw();
      showToast('เพิ่มชั้นดินใหม่แล้ว', 'success');
    }

    function removeSoilLayer(index) {
      if (soilLayers.length <= 1) {
        showToast('ต้องมีชั้นดินอย่างน้อย 1 ชั้น', 'error');
        return;
      }
      soilLayers.splice(index, 1);
      renderSoilLayersList();
      updateDraw();
      showToast('ลบชั้นดินเรียบร้อย', 'info');
    }

    function updateSoilLayer(index, field, value) {
      if (field === 'thickness' && (isNaN(value) || value <= 0)) return;
      soilLayers[index][field] = value;
      updateDraw();
    }

    function loadPreset(key) {
      const p = presets[key];
      if (!p) return;

      document.getElementById('groundEl').value = p.groundEl.toFixed(2);
      document.getElementById('pipeCrownEl').value = p.pipeCrownEl.toFixed(2);
      document.getElementById('coverDepthInput').value = (p.groundEl - p.pipeCrownEl).toFixed(2);
      setPipeShape(p.shape);

      if (p.shape === 'circular') {
        document.getElementById('innerDiameter').value = p.innerDiameter;
        document.getElementById('wallThickCircle').value = p.wallThick;
      } else {
        document.getElementById('boxWidth').value = p.boxWidth;
        document.getElementById('boxHeight').value = p.boxHeight;
        document.getElementById('wallThickBox').value = p.wallThickBox;
      }

      document.getElementById('numPipes').value = p.numPipes;
      document.getElementById('pipeSpacing').value = p.pipeSpacing;
      document.getElementById('beddingThick').value = p.beddingThick;
      document.getElementById('beddingType').value = p.beddingType;
      document.getElementById('waterLevelPct').value = p.waterLevelPct;
      document.getElementById('waterPctLabel').innerText = p.waterLevelPct + '%';

      soilLayers = JSON.parse(JSON.stringify(p.soilLayers));
      renderSoilLayersList();
      resetZoom();
      updateDraw();
      showToast('โหลดตัวอย่างแบบแปลนเรียบร้อย', 'success');
    }

