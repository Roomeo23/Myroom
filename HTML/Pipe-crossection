        <!-- Stiff Clay Crosshatch Pattern -->
        <pattern id="pat_stiff_clay" width="16" height="16" patternUnits="userSpaceOnUse">
          <path d="M0,16 L16,0 M0,0 L16,16" stroke="#ffffff" stroke-width="0.7" opacity="0.2"/>
        </pattern>

        <!-- Concrete Wall Hatch -->
        <pattern id="pat_concrete" width="14" height="14" patternUnits="userSpaceOnUse">
          <path d="M0,14 L14,0" stroke="#94a3b8" stroke-width="1.2" opacity="0.5"/>
          <circle cx="4" cy="4" r="0.8" fill="#cbd5e1" opacity="0.6"/>
          <circle cx="10" cy="9" r="1" fill="#cbd5e1" opacity="0.5"/>
