<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Soil Layers & Pipe Cross-Section Visualizer</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Sarabun & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <style>
    body {
      font-family: 'Sarabun', 'Inter', sans-serif;
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
    /* Grid background for CAD feel */
    .cad-grid-bg {
      background-color: #0f172a;
      background-image: 
        radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 0),
        linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      background-size: 20px 20px, 40px 40px, 40px 40px;
      background-position: -1px -1px, -1px -1px, -1px -1px;
    }
    /* SVG crosshair cursor */
    .crosshair-cursor {
      cursor: crosshair;
    }
  </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col antialiased">

  <!-- Header Section -->
  <header class="bg-slate-800 border-b border-slate-700 px-4 py-3 shrink-0 flex flex-wrap items-center justify-between gap-3 shadow-md">
    <div class="flex items-center space-x-3">
      <div class="bg-blue-600 text-white p-2 rounded-lg shadow-inner">
        <i class="fa-solid fa-layer-group text-xl"></i>
      </div>
      <div>
        <h1 class="font-bold text-lg text-white leading-tight">โปรแกรมจำลองภาพตัดขวางชั้นดินและการวางท่อ</h1>
        <p class="text-xs text-slate-400">Soil Layers & Pipe Cross-Section Visualizer (Civil & Hydraulics)</p>
      </div>
    </div>
    
    <!-- Quick Actions / Presets -->
    <div class="flex items-center space-x-2">
      <div class="relative inline-block">
        <select id="presetSelect" onchange="loadPreset(this.value)" class="bg-slate-700 text-slate-200 text-xs rounded-lg border border-slate-600 px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="" disabled selected>-- โหลดแม่แบบตัวอย่าง (Presets) --</option>
          <option value="drainage_twin">ท่อระบายน้ำ คสล. Ø1.20ม. คู่ 2 แถว (งานถนน)</option>
          <option value="box_culvert_triple">ท่อเหลี่ยม คสล. Box Culvert 2.50x2.00ม. 3 ช่อง (งานชลประทาน)</option>
          <option value="single_pipe_deep">ท่อกลมเดี่ยว Ø1.50ม. วางลึกพิเศษ (งานท่อรวบรวมน้ำเสีย)</option>
        </select>
      </div>

      <button onclick="exportSVG()" class="bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs px-3 py-1.5 rounded-lg border border-slate-600 transition flex items-center space-x-1">
        <i class="fa-solid fa-file-code text-blue-400"></i>
        <span>SVG</span>
      </button>

      <button onclick="exportPNG()" class="bg-blue-600 hover:bg-blue-500 text-white text-xs px-3 py-1.5 rounded-lg shadow transition flex items-center space-x-1">
        <i class="fa-solid fa-download"></i>
        <span>ส่งออก PNG</span>
      </button>
    </div>
  </header>

  <!-- Main Content Layout -->
  <div class="flex-1 flex flex-col lg:flex-row overflow-hidden">
    
    <!-- LEFT SIDEBAR: Control Panel -->
    <aside class="w-full lg:w-[430px] xl:w-[460px] bg-slate-800 border-r border-slate-700 flex flex-col shrink-0 overflow-y-auto custom-scrollbar">
      <div class="p-4 space-y-5">
        
        <!-- 1. Elevation Reference Settings -->
        <div class="bg-slate-900/60 p-3.5 rounded-xl border border-slate-700/70 shadow-sm space-y-3">
          <div class="flex items-center justify-between border-b border-slate-700 pb-2">
            <h2 class="font-semibold text-sm text-blue-400 flex items-center gap-2">
              <i class="fa-solid fa-arrows-up-down text-blue-400"></i>
              ระดับและดินถม (Elevations & Cover Depth)
            </h2>
            <span class="text-[10px] text-slate-400 bg-slate-800 px-2 py-0.5 rounded">m MSL / m</span>
          </div>

          <!-- Sync Mode Selector Toggle -->
          <div class="bg-slate-800/80 p-1.5 rounded-lg border border-slate-700 flex flex-wrap items-center justify-between gap-1.5 text-[11px]">
            <span class="text-slate-400 pl-1"><i class="fa-solid fa-link text-xs mr-1 text-cyan-400"></i>โหมดเชื่อมโยง:</span>
            <div class="flex flex-wrap items-center gap-1">
              <button type="button" id="btnSyncCover" onclick="setSyncMode('cover')" class="px-2 py-1 rounded transition text-xs bg-blue-600 text-white font-medium" title="ปรับดินถม -> คำนวณระดับหลังท่อและท้องท่อ">
                ล็อกดินถม (H_cover)
              </button>
              <button type="button" id="btnSyncCrown" onclick="setSyncMode('crown')" class="px-2 py-1 rounded transition text-xs bg-slate-700 text-slate-300 hover:bg-slate-600" title="ปรับระดับหลังท่อ -> คำนวณดินถมและท้องท่อ">
                ล็อกระดับหลังท่อ (Z_crown)
              </button>
              <button type="button" id="btnSyncInvert" onclick="setSyncMode('invert')" class="px-2 py-1 rounded transition text-xs bg-slate-700 text-slate-300 hover:bg-slate-600" title="ปรับระดับท้องท่อ -> คำนวณระดับหลังท่อและดินถม">
                ล็อกท้องท่อ (Z_invert)
              </button>
            </div>
          </div>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <div>
              <label class="block text-[11px] text-amber-300 mb-1 font-semibold">
                <i class="fa-solid fa-star text-[10px] mr-1"></i>ผิวดินหลัก (Z_ground)
              </label>
              <div class="flex items-center bg-slate-800 border-2 border-amber-400/80 rounded-lg focus-within:ring-2 focus-within:ring-amber-400 overflow-hidden shadow-sm">
                <input type="number" id="groundEl" value="10.00" step="0.001" oninput="handleGroundInput()" onchange="handleGroundInput()" class="w-full min-w-0 bg-transparent text-amber-200 font-mono font-bold text-xs px-2.5 py-1.5 focus:outline-none">
                <span class="text-[10px] text-amber-300 bg-slate-900/80 px-2 py-1.5 border-l border-slate-700 shrink-0">m MSL</span>
              </div>
            </div>

            <div>
              <label id="lblCoverField" class="block text-[11px] text-slate-300 mb-1">ดินถม (H_cover)</label>
              <div id="boxCoverField" class="flex items-center bg-slate-800/80 border border-slate-600 rounded-lg focus-within:ring-2 focus-within:ring-cyan-500 overflow-hidden transition">
                <input type="number" id="coverDepthInput" value="2.50" min="0" step="0.001" oninput="handleCoverInput()" onchange="handleCoverInput()" class="w-full min-w-0 bg-transparent text-cyan-300 font-mono font-bold text-xs px-2.5 py-1.5 focus:outline-none">
                <span class="text-[10px] text-cyan-400/90 bg-slate-900/70 px-2 py-1.5 border-l border-slate-700 shrink-0">m</span>
              </div>
            </div>

            <div>
              <label id="lblCrownField" class="block text-[11px] text-slate-300 mb-1">หลังท่อ (Z_crown)</label>
              <div id="boxCrownField" class="flex items-center bg-slate-800/80 border border-slate-600 rounded-lg focus-within:ring-2 focus-within:ring-blue-500 overflow-hidden transition">
                <input type="number" id="pipeCrownEl" value="7.50" step="0.001" oninput="handleCrownInput()" onchange="handleCrownInput()" class="w-full min-w-0 bg-transparent text-blue-300 font-mono font-bold text-xs px-2.5 py-1.5 focus:outline-none">
                <span class="text-[10px] text-blue-400/90 bg-slate-900/70 px-2 py-1.5 border-l border-slate-700 shrink-0">m MSL</span>
              </div>
            </div>

            <div>
              <label id="lblInvertField" class="block text-[11px] text-slate-300 mb-1">ท้องท่อ (Z_invert)</label>
              <div id="boxInvertField" class="flex items-center bg-slate-800/80 border border-slate-600 rounded-lg focus-within:ring-2 focus-within:ring-emerald-500 overflow-hidden transition">
                <input type="number" id="pipeInvertEl" value="6.06" step="0.001" oninput="handleInvertInput()" onchange="handleInvertInput()" class="w-full min-w-0 bg-transparent text-emerald-300 font-mono font-bold text-xs px-2.5 py-1.5 focus:outline-none">
                <span class="text-[10px] text-emerald-400/90 bg-slate-900/70 px-2 py-1.5 border-l border-slate-700 shrink-0">m MSL</span>
              </div>
            </div>
          </div>

          <div id="syncStatusNotice" class="text-[10px] text-cyan-400/90 bg-cyan-950/40 border border-cyan-800/40 rounded px-2.5 py-1.5 flex flex-wrap items-center justify-between gap-1">
            <span><i class="fa-solid fa-calculator mr-1"></i>สูตร: Z_crown = Z_ground - H_cover</span>
            <span class="font-mono text-slate-300 shrink-0">Auto Sync Active</span>
          </div>
        </div>

        <!-- 2. Pipe Geometry Settings -->
        <div class="bg-slate-900/60 p-3.5 rounded-xl border border-slate-700/70 shadow-sm space-y-3">
          <div class="flex items-center justify-between border-b border-slate-700 pb-2">
            <h2 class="font-semibold text-sm text-blue-400 flex items-center gap-2">
              <i class="fa-solid fa-shapes text-blue-400"></i>
              รูปทรงและขนาดท่อ (Pipe Geometry)
            </h2>
          </div>

          <div>
            <label class="block text-xs text-slate-300 mb-1">รูปทรงท่อ (Pipe Shape)</label>
            <div class="grid grid-cols-2 gap-2">
              <button type="button" id="btnShapeCircle" onclick="setPipeShape('circular')" class="px-3 py-1.5 text-xs rounded-lg border flex items-center justify-center space-x-2 transition bg-blue-600 text-white border-blue-500">
                <i class="fa-regular fa-circle"></i>
                <span>ท่อกลม (Circular)</span>
              </button>
              <button type="button" id="btnShapeBox" onclick="setPipeShape('box')" class="px-3 py-1.5 text-xs rounded-lg border flex items-center justify-center space-x-2 transition bg-slate-800 text-slate-300 border-slate-600 hover:bg-slate-700">
                <i class="fa-regular fa-square"></i>
                <span>ท่อเหลี่ยม (Box)</span>
              </button>
            </div>
          </div>

          <!-- Circular Dimensions Controls -->
          <div id="circularInputs" class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs text-slate-300 mb-1">เส้นผ่านศูนย์กลางใน (Inner Dia, Di)</label>
              <div class="relative">
                <input type="number" id="innerDiameter" value="1.20" min="0.1" step="0.05" class="w-full bg-slate-800 text-white text-xs border border-slate-600 rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-500" onchange="handlePipeSizeChange()">
                <span class="absolute right-2 top-1.5 text-[10px] text-slate-400">m</span>
              </div>
            </div>
            <div>
              <label class="block text-xs text-slate-300 mb-1">ความหนาผนัง (Wall Thick, t)</label>
              <div class="relative">
                <input type="number" id="wallThickCircle" value="0.12" min="0.02" step="0.01" class="w-full bg-slate-800 text-white text-xs border border-slate-600 rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-500" onchange="handlePipeSizeChange()">
                <span class="absolute right-2 top-1.5 text-[10px] text-slate-400">m</span>
              </div>
            </div>
          </div>

          <!-- Box Culvert Dimensions Controls -->
          <div id="boxInputs" class="grid grid-cols-3 gap-2 hidden">
            <div>
              <label class="block text-xs text-slate-300 mb-1">ความกว้างใน (Wi)</label>
              <div class="relative">
                <input type="number" id="boxWidth" value="2.00" min="0.5" step="0.1" class="w-full bg-slate-800 text-white text-xs border border-slate-600 rounded-lg px-2 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-500" onchange="handlePipeSizeChange()">
                <span class="absolute right-1.5 top-1.5 text-[10px] text-slate-400">m</span>
              </div>
            </div>
            <div>
              <label class="block text-xs text-slate-300 mb-1">ความสูงใน (Hi)</label>
              <div class="relative">
                <input type="number" id="boxHeight" value="1.50" min="0.5" step="0.1" class="w-full bg-slate-800 text-white text-xs border border-slate-600 rounded-lg px-2 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-500" onchange="handlePipeSizeChange()">
                <span class="absolute right-1.5 top-1.5 text-[10px] text-slate-400">m</span>
              </div>
            </div>
            <div>
              <label class="block text-xs text-slate-300 mb-1">หนาผนัง (t)</label>
              <div class="relative">
                <input type="number" id="wallThickBox" value="0.20" min="0.05" step="0.01" class="w-full bg-slate-800 text-white text-xs border border-slate-600 rounded-lg px-2 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-500" onchange="handlePipeSizeChange()">
                <span class="absolute right-1.5 top-1.5 text-[10px] text-slate-400">m</span>
              </div>
            </div>
          </div>

          <!-- Multi-Pipe / Spacing -->
          <div class="grid grid-cols-2 gap-3 pt-1 border-t border-slate-800">
            <div>
              <label class="block text-xs text-slate-300 mb-1">จำนวนท่อ (Barrels)</label>
              <input type="number" id="numPipes" value="2" min="1" max="6" step="1" class="w-full bg-slate-800 text-white text-xs border border-slate-600 rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-500" onchange="updateDraw()">
            </div>
            <div>
              <label class="block text-xs text-slate-300 mb-1">ระยะห่างท่อ (Spacing S)</label>
              <div class="relative">
                <input type="number" id="pipeSpacing" value="0.50" min="0.1" step="0.05" class="w-full bg-slate-800 text-white text-xs border border-slate-600 rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-500" onchange="updateDraw()">
                <span class="absolute right-2 top-1.5 text-[10px] text-slate-400">m</span>
              </div>
            </div>
          </div>

          <!-- Water Depth Inside Pipe -->
          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs text-slate-300">ระดับน้ำในท่อ (Water Level %)</label>
              <span id="waterPctLabel" class="text-xs text-cyan-400 font-mono">40%</span>
            </div>
            <input type="range" id="waterLevelPct" value="40" min="0" max="100" class="w-full accent-cyan-500 cursor-pointer" oninput="document.getElementById('waterPctLabel').innerText=this.value+'%'; updateDraw()">
          </div>

        </div>

        <!-- 3. Bedding & Trench Settings -->
        <div class="bg-slate-900/60 p-3.5 rounded-xl border border-slate-700/70 shadow-sm space-y-3">
          <div class="flex items-center justify-between border-b border-slate-700 pb-2">
            <h2 class="font-semibold text-sm text-blue-400 flex items-center gap-2">
              <i class="fa-solid fa-cubes text-blue-400"></i>
              ชั้นวัสดุรองพื้นท่อ (Pipe Bedding)
            </h2>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs text-slate-300 mb-1">ความหนารองพื้น (Thickness)</label>
              <div class="relative">
                <input type="number" id="beddingThick" value="0.15" min="0" step="0.05" class="w-full bg-slate-800 text-white text-xs border border-slate-600 rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-500" onchange="updateDraw()">
                <span class="absolute right-2 top-1.5 text-[10px] text-slate-400">m</span>
              </div>
            </div>
            <div>
              <label class="block text-xs text-slate-300 mb-1">ชนิดวัสดุรองพื้น</label>
              <select id="beddingType" onchange="updateDraw()" class="w-full bg-slate-800 text-white text-xs border border-slate-600 rounded-lg px-2 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="sand">ทรายหยาบ (Sand Bedding)</option>
                <option value="gravel">หินย่อย (Crushed Stone)</option>
                <option value="concrete">คอนกรีตรองพื้น (Lean Concrete)</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs text-slate-300 mb-1">ระยะยื่นขอบร่อง (Side Clearance)</label>
              <div class="relative">
                <input type="number" id="trenchClearance" value="0.50" min="0.2" step="0.05" class="w-full bg-slate-800 text-white text-xs border border-slate-600 rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-500" onchange="updateDraw()">
                <span class="absolute right-2 top-1.5 text-[10px] text-slate-400">m</span>
              </div>
            </div>
            <div>
              <label class="block text-xs text-slate-300 mb-1">มุมสโลปร่องขุด (Trench Slope)</label>
              <select id="trenchSlope" onchange="updateDraw()" class="w-full bg-slate-800 text-white text-xs border border-slate-600 rounded-lg px-2 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="0">ดิ่งตรง (1:0)</option>
                <option value="0.25">ลาดเอียงนิดหน่อย (1:0.25)</option>
                <option value="0.5" selected>ลาดเอียงมาตรฐาน (1:0.5)</option>
                <option value="1.0">ลาดเอียงปลอดภัย (1:1.0)</option>
              </select>
            </div>
          </div>
        </div>

        <!-- 4. Dynamic Soil Layers Editor -->
        <div class="bg-slate-900/60 p-3.5 rounded-xl border border-slate-700/70 shadow-sm space-y-3">
          <div class="flex items-center justify-between border-b border-slate-700 pb-2">
            <h2 class="font-semibold text-sm text-blue-400 flex items-center gap-2">
              <i class="fa-solid fa-layer-group text-blue-400"></i>
              ชั้นดินตามธรรมชาติ (Dynamic Soil Layers)
            </h2>
            <button onclick="addSoilLayer()" class="bg-blue-600 hover:bg-blue-500 text-white text-[11px] px-2.5 py-1 rounded-md transition flex items-center gap-1">
              <i class="fa-solid fa-plus"></i> เพิ่มชั้นดิน
            </button>
          </div>

          <!-- Soil Layers Container -->
          <div id="soilLayersList" class="space-y-2.5 max-h-[260px] overflow-y-auto custom-scrollbar pr-1">
            <!-- Soil layer items injected by JavaScript -->
          </div>
        </div>

      </div>
    </aside>

    <!-- RIGHT MAIN CANVAS AREA -->
    <main class="flex-1 flex flex-col bg-slate-950 relative overflow-hidden">
      
      <!-- Canvas Control Toolbar -->
      <div class="bg-slate-900/90 backdrop-blur border-b border-slate-800 px-4 py-2 flex items-center justify-between text-xs z-10 shrink-0">
        <div class="flex items-center space-x-4">
          <span class="text-slate-400 font-mono flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Cross-Section Drawing (Scale 1:1)
          </span>
          <div class="hidden sm:flex items-center space-x-3 text-slate-400">
            <label class="flex items-center gap-1 cursor-pointer hover:text-white">
              <input type="checkbox" id="chkCallouts" checked onchange="updateDraw()" class="rounded bg-slate-800 border-slate-700 text-blue-500">
              <span>แสดงระดับสำคัญ (Callouts)</span>
            </label>
            <label class="flex items-center gap-1 cursor-pointer hover:text-white">
              <input type="checkbox" id="chkGrid" checked onchange="updateDraw()" class="rounded bg-slate-800 border-slate-700 text-blue-500">
              <span>แสดงเส้นกริด (Grid)</span>
            </label>
            <label class="flex items-center gap-1 cursor-pointer hover:text-white">
              <input type="checkbox" id="chkDimensions" checked onchange="updateDraw()" class="rounded bg-slate-800 border-slate-700 text-blue-500">
              <span>แสดงเส้นมิติ (Dimensions)</span>
            </label>
          </div>
        </div>

        <!-- Zoom Controls -->
        <div class="flex items-center space-x-1.5 bg-slate-800 p-1 rounded-lg border border-slate-700">
          <button onclick="zoomIn()" class="w-7 h-7 flex items-center justify-center hover:bg-slate-700 text-slate-300 rounded transition" title="Zoom In">
            <i class="fa-solid fa-magnifying-glass-plus"></i>
          </button>
          <button onclick="zoomOut()" class="w-7 h-7 flex items-center justify-center hover:bg-slate-700 text-slate-300 rounded transition" title="Zoom Out">
            <i class="fa-solid fa-magnifying-glass-minus"></i>
          </button>
          <button onclick="resetZoom()" class="px-2 h-7 flex items-center justify-center hover:bg-slate-700 text-slate-300 rounded text-[11px] transition" title="Reset Zoom">
            <i class="fa-solid fa-rotate-left mr-1"></i> Reset View
          </button>
        </div>
      </div>

      <!-- Interactive Drawing Area Container -->
      <div id="svgContainer" class="flex-1 relative cad-grid-bg overflow-hidden select-none crosshair-cursor">
        
        <!-- Interactive Inspector HUD (Top Right overlay) -->
