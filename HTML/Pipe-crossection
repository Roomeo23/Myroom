        <pattern id="pat_sand" width="12" height="12" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1" fill="#ffffff" opacity="0.35"/>
          <circle cx="8" cy="7" r="1" fill="#ffffff" opacity="0.25"/>
          <circle cx="5" cy="10" r="0.8" fill="#ffffff" opacity="0.4"/>
