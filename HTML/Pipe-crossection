    function clearDynamicPipeClips() {
      const defs = document.getElementById('svgDefs');
      defs.querySelectorAll('clipPath[id^="pipeClip_"]').forEach(el => el.remove());
    }

    // --- MAIN DRAWING CALCULATION & ENGINE ---
    let currentCalcState = null;

    function updateDraw() {
      // 1. Read Inputs & Sync according to active mode
      const groundEl = parseFloat(document.getElementById('groundEl').value) || 10.0;
      const elevDec = getActiveElevationDecimals();
      const numPipes = parseInt(document.getElementById('numPipes').value) || 1;
      const pipeSpacing = parseFloat(document.getElementById('pipeSpacing').value) || 0.5;
      const beddingThick = parseFloat(document.getElementById('beddingThick').value) || 0.15;
      const beddingType = document.getElementById('beddingType').value;
      const trenchClearance = parseFloat(document.getElementById('trenchClearance').value) || 0.5;
      const trenchSlope = parseFloat(document.getElementById('trenchSlope').value) || 0.5;
      const waterLevelPct = parseFloat(document.getElementById('waterLevelPct').value) || 0;

      const showCallouts = document.getElementById('chkCallouts').checked;
      const showGrid = document.getElementById('chkGrid').checked;
      const showDimensions = document.getElementById('chkDimensions').checked;

      // Pipe Dimensions
      let innerW, innerH, wallThick, outerW, outerH;
      if (currentShape === 'circular') {
        innerW = parseFloat(document.getElementById('innerDiameter').value) || 1.2;
        innerH = innerW;
        wallThick = parseFloat(document.getElementById('wallThickCircle').value) || 0.12;
        outerW = innerW + 2 * wallThick;
        outerH = outerW;
      } else {
        innerW = parseFloat(document.getElementById('boxWidth').value) || 2.0;
        innerH = parseFloat(document.getElementById('boxHeight').value) || 1.5;
        wallThick = parseFloat(document.getElementById('wallThickBox').value) || 0.2;
        outerW = innerW + 2 * wallThick;
        outerH = innerH + 2 * wallThick;
      }

      const pipeSpanH = wallThick + innerH;
      let pipeCrownEl = parseFloat(document.getElementById('pipeCrownEl').value) || 7.5;
      let coverDepth = parseFloat(document.getElementById('coverDepthInput').value);
      const invertInputEl = document.getElementById('pipeInvertEl');
      let pipeInvertEl = invertInputEl ? parseFloat(invertInputEl.value) : (groundEl - (isNaN(coverDepth) ? (groundEl - pipeCrownEl) : coverDepth) - pipeSpanH);

      if (syncMode === 'cover') {
        if (isNaN(coverDepth)) coverDepth = groundEl - pipeCrownEl;
        pipeCrownEl = groundEl - coverDepth;
        pipeInvertEl = groundEl - coverDepth - wallThick - innerH;
        document.getElementById('pipeCrownEl').value = formatElevationVal(pipeCrownEl, elevDec);
        if (invertInputEl) invertInputEl.value = formatElevationVal(pipeInvertEl, elevDec);
      } else if (syncMode === 'crown') {
        coverDepth = groundEl - pipeCrownEl;
        pipeInvertEl = pipeCrownEl - wallThick - innerH;
        document.getElementById('coverDepthInput').value = formatElevationVal(coverDepth, elevDec);
        if (invertInputEl) invertInputEl.value = formatElevationVal(pipeInvertEl, elevDec);
      } else if (syncMode === 'invert') {
        if (isNaN(pipeInvertEl)) pipeInvertEl = groundEl - coverDepth - pipeSpanH;
        pipeCrownEl = pipeInvertEl + wallThick + innerH;
        coverDepth = groundEl - pipeCrownEl;
        document.getElementById('pipeCrownEl').value = formatElevationVal(pipeCrownEl, elevDec);
        document.getElementById('coverDepthInput').value = formatElevationVal(coverDepth, elevDec);
      }

      // Calculations of Key Elevations
      const outerCrownEl = pipeCrownEl;
      const innerCrownEl = outerCrownEl - wallThick;
      const centerlineEl = outerCrownEl - (outerH / 2);
      const innerInvertEl = outerCrownEl - wallThick - innerH;
      const outerInvertEl = syncMode === 'invert' ? pipeInvertEl : (outerCrownEl - wallThick - innerH);
      const beddingBottomEl = outerInvertEl - beddingThick;
      coverDepth = groundEl - (parseFloat(document.getElementById('pipeCrownEl').value) || pipeCrownEl);

      // Total Pipe Group Horizontal Span
      const totalPipesWidth = (numPipes * outerW) + ((numPipes - 1) * pipeSpacing);
      const trenchBottomWidth = totalPipesWidth + (2 * trenchClearance);
      
      // Calculate Soil Depths & Lowest View Elevation
      let totalSoilDepth = 0;
      soilLayers.forEach(l => totalSoilDepth += l.thickness);
      let bottomSoilEl = groundEl - totalSoilDepth;

      // Ensure view includes bedding and extra foundation depth
      const minRequiredEl = beddingBottomEl - 1.2;
      if (bottomSoilEl > minRequiredEl) {
        // Extend last soil layer visually or add foundation
        const extraNeeded = bottomSoilEl - minRequiredEl;
        soilLayers[soilLayers.length - 1].thickness += extraNeeded;
        totalSoilDepth += extraNeeded;
        bottomSoilEl = minRequiredEl;
      }

      // Store State for Cursor Inspector
      currentCalcState = {
        groundEl, outerCrownEl, innerCrownEl, centerlineEl, innerInvertEl, outerInvertEl,
        beddingBottomEl, coverDepth, elevDec, innerW, innerH, wallThick, outerW, outerH,
        numPipes, pipeSpacing, totalPipesWidth, beddingThick, bottomSoilEl, waterLevelPct
      };

      // Update Summary UI Cards
      document.getElementById('summaryGround').innerText = `${groundEl >= 0 ? '+' : ''}${formatElevationVal(groundEl, elevDec)}`;
      document.getElementById('summaryCover').innerText = `${formatElevationVal(coverDepth, elevDec)} m`;
      document.getElementById('summaryCrown').innerText = `${outerCrownEl >= 0 ? '+' : ''}${formatElevationVal(outerCrownEl, elevDec)}`;
      document.getElementById('summaryInnerCrown').innerText = `${innerCrownEl >= 0 ? '+' : ''}${formatElevationVal(innerCrownEl, elevDec)}`;
      document.getElementById('summaryCenter').innerText = `${centerlineEl >= 0 ? '+' : ''}${formatElevationVal(centerlineEl, elevDec)}`;
      document.getElementById('summaryInvert').innerText = `${innerInvertEl >= 0 ? '+' : ''}${formatElevationVal(innerInvertEl, elevDec)}`;
      document.getElementById('summaryOuterInvert').innerText = `${outerInvertEl >= 0 ? '+' : ''}${formatElevationVal(outerInvertEl, elevDec)}`;
      document.getElementById('summaryBedding').innerText = `${beddingBottomEl >= 0 ? '+' : ''}${formatElevationVal(beddingBottomEl, elevDec)}`;

      // Status Warning Badge
      const statusBadge = document.getElementById('statusBadge');
      if (coverDepth < 0) {
        statusBadge.innerHTML = `<i class="fa-solid fa-circle-exclamation text-rose-400"></i><span class="text-rose-300">เตือน: หลังท่ออยู่สูงกว่าระดับผิวดิน (H_cover < 0m)</span>`;
        statusBadge.classList.remove('hidden');
      } else if (coverDepth < 0.3) {
        statusBadge.innerHTML = `<i class="fa-solid fa-triangle-exclamation text-amber-400"></i><span class="text-amber-300">เตือน: ความลึกดินถมหลังท่อน้อยกว่า 0.30 ม. (เสี่ยงโครงสร้างเสียหาย)</span>`;
        statusBadge.classList.remove('hidden');
      } else if (coverDepth > 6.0) {
        statusBadge.innerHTML = `<i class="fa-solid fa-circle-info text-cyan-400"></i><span class="text-cyan-300">ความลึกฝังท่อสูง (>6.0ม.) ควรคำนวณกำลังรับโหลดพิเศษ</span>`;
        statusBadge.classList.remove('hidden');
      } else {
        statusBadge.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-400"></i><span class="text-emerald-300">ระดับการวางท่อสมบูรณ์และได้มาตรฐาน</span>`;
        statusBadge.classList.remove('hidden');
      }

      // 2. Setup World Coordinate Bounds for Canvas
      const worldWidth = Math.max(totalPipesWidth + 6.0, (groundEl - bottomSoilEl) * 1.5);
      const worldHeight = (groundEl - bottomSoilEl) + 1.6; // Margin top/bottom
      
      const minX = -worldWidth / 2;
      const maxX = worldWidth / 2;
      const maxY = groundEl + 0.8;
      const minY = bottomSoilEl - 0.8;

      const svg = document.getElementById('mainSVG');
      const viewportGroup = document.getElementById('viewportGroup');
      const containerRect = document.getElementById('svgContainer').getBoundingClientRect();
      const svgW = containerRect.width || 800;
      const svgH = containerRect.height || 600;

      // Coordinate Mapping Functions (World -> Canvas Pixels)
      const scaleX = (svgW - 140) / (maxX - minX);
      const scaleY = (svgH - 100) / (maxY - minY);
      const scale = Math.min(scaleX, scaleY) * zoomLevel;

      const originX = svgW / 2 + panX;
      const originY = 50 + (maxY - groundEl) * scale + panY;

      function toPxX(x) { return originX + x * scale; }
      function toPxY(y) { return originY + (groundEl - y) * scale; }
      function toLen(m) { return m * scale; }

      currentCalcState.toPxX = toPxX;
      currentCalcState.toPxY = toPxY;
      currentCalcState.toLen = toLen;
      currentCalcState.fromPxX = (px) => (px - originX) / scale;
      currentCalcState.fromPxY = (py) => groundEl - ((py - originY) / scale);
      // Clear viewport and old per-pipe clip paths
      viewportGroup.innerHTML = '';
      clearDynamicPipeClips();

      // --- A. BACKGROUND GRID & AXES ---
      if (showGrid) {
        let gridGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        gridGroup.setAttribute('opacity', '0.25');

        // Horizontal Elevation Grids (Every 0.5m or 1.0m)
        const stepY = (maxY - minY > 8) ? 1.0 : 0.5;
        const startY = Math.floor(minY / stepY) * stepY;
        for (let y = startY; y <= maxY; y += stepY) {
          const py = toPxY(y);
          const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
          line.setAttribute('x1', 0);
          line.setAttribute('y1', py);
          line.setAttribute('x2', svgW);
          line.setAttribute('y2', py);
          line.setAttribute('stroke', '#64748b');
          line.setAttribute('stroke-dasharray', y === groundEl ? '0' : '3,3');
          gridGroup.appendChild(line);
        }

        // Vertical Grids (Every 1.0m)
        for (let x = Math.floor(minX); x <= Math.ceil(maxX); x += 1.0) {
          const px = toPxX(x);
          const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
          line.setAttribute('x1', px);
          line.setAttribute('y1', 0);
          line.setAttribute('x2', px);
          line.setAttribute('y2', svgH);
          line.setAttribute('stroke', '#64748b');
          line.setAttribute('stroke-dasharray', x === 0 ? '0' : '4,4');
          gridGroup.appendChild(line);
        }
        viewportGroup.appendChild(gridGroup);
      }

      // --- B. DRAW NATURAL SOIL LAYERS ---
      let currentTopY = groundEl;
      let soilGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');

      soilLayers.forEach((layer, idx) => {
        const nextTopY = currentTopY - layer.thickness;
        const pTopY = toPxY(currentTopY);
        const pBotY = toPxY(nextTopY);
        const pLeftX = toPxX(minX - 2.0);
        const pRightX = toPxX(maxX + 2.0);

        // Layer Solid Background Rect
        const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
        rect.setAttribute('x', pLeftX);
        rect.setAttribute('y', pTopY);
        rect.setAttribute('width', pRightX - pLeftX);
        rect.setAttribute('height', pBotY - pTopY);
        rect.setAttribute('fill', layer.color);
        rect.setAttribute('opacity', '0.65');
        soilGroup.appendChild(rect);

        // Overlay Hatch Pattern Rect
        if (layer.pattern) {
          const hatchRect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
          hatchRect.setAttribute('x', pLeftX);
          hatchRect.setAttribute('y', pTopY);
          hatchRect.setAttribute('width', pRightX - pLeftX);
          hatchRect.setAttribute('height', pBotY - pTopY);
          hatchRect.setAttribute('fill', `url(#pat_${layer.pattern})`);
          soilGroup.appendChild(hatchRect);
        }

        // Soil Interface Line
        if (idx > 0) {
          const interfaceLine = document.createElementNS('http://www.w3.org/2000/svg', 'line');
          interfaceLine.setAttribute('x1', pLeftX);
          interfaceLine.setAttribute('y1', pTopY);
          interfaceLine.setAttribute('x2', pRightX);
          interfaceLine.setAttribute('y2', pTopY);
          interfaceLine.setAttribute('stroke', '#cbd5e1');
          interfaceLine.setAttribute('stroke-width', '1');
          interfaceLine.setAttribute('stroke-dasharray', '5,3');
          soilGroup.appendChild(interfaceLine);
        }

        // Layer Name Label in Canvas
        const textLabel = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        textLabel.setAttribute('x', toPxX(maxX - 0.3));
        textLabel.setAttribute('y', pTopY + (pBotY - pTopY)/2 + 4);
        textLabel.setAttribute('fill', '#f1f5f9');
        textLabel.setAttribute('font-size', '11');
        textLabel.setAttribute('font-weight', '500');
        textLabel.setAttribute('text-anchor', 'end');
        textLabel.setAttribute('opacity', '0.85');
        textLabel.textContent = `${layer.name} (หนา ${layer.thickness.toFixed(2)}ม.)`;
        soilGroup.appendChild(textLabel);

        currentTopY = nextTopY;
      });

      viewportGroup.appendChild(soilGroup);

      // --- C. DRAW TRENCH EXCAVATION & BEDDING LAYER ---
      let trenchGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      
      const trenchBotLeftX = -trenchBottomWidth / 2;
      const trenchBotRightX = trenchBottomWidth / 2;
      const trenchDepth = groundEl - beddingBottomEl;
      const trenchTopLeftX = trenchBotLeftX - (trenchDepth * trenchSlope);
      const trenchTopRightX = trenchBotRightX + (trenchDepth * trenchSlope);

      // Bedding Polygon (Under Pipes)
      const pBedTopY = toPxY(outerInvertEl);
      const pBedBotY = toPxY(beddingBottomEl);
      const pBedLX = toPxX(trenchBotLeftX);
      const pBedRX = toPxX(trenchBotRightX);

      // Bedding Fill Color
      let bedFill = '#d97706'; // sand default
      let bedPattern = 'url(#pat_sand)';
      if (beddingType === 'gravel') {
        bedFill = '#475569';
        bedPattern = 'url(#pat_gravel)';
      } else if (beddingType === 'concrete') {
        bedFill = '#334155';
        bedPattern = 'url(#pat_lean_concrete)';
      }

      const bedPoly = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
      const bedPoints = `${pBedLX},${pBedTopY} ${pBedRX},${pBedTopY} ${pBedRX},${pBedBotY} ${pBedLX},${pBedBotY}`;
      bedPoly.setAttribute('points', bedPoints);
      bedPoly.setAttribute('fill', bedFill);
      bedPoly.setAttribute('opacity', '0.8');
      trenchGroup.appendChild(bedPoly);

      const bedHatch = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
      bedHatch.setAttribute('points', bedPoints);
      bedHatch.setAttribute('fill', bedPattern);
      trenchGroup.appendChild(bedHatch);

      // Trench Cut Line (Dashed Civil Cut Line)
      const pTrTL = `${toPxX(trenchTopLeftX)},${toPxY(groundEl)}`;
      const pTrBL = `${toPxX(trenchBotLeftX)},${toPxY(beddingBottomEl)}`;
      const pTrBR = `${toPxX(trenchBotRightX)},${toPxY(beddingBottomEl)}`;
      const pTrTR = `${toPxX(trenchTopRightX)},${toPxY(groundEl)}`;

      const trenchOutline = document.createElementNS('http://www.w3.org/2000/svg', 'polyline');
      trenchOutline.setAttribute('points', `${pTrTL} ${pTrBL} ${pTrBR} ${pTrTR}`);
      trenchOutline.setAttribute('fill', 'none');
      trenchOutline.setAttribute('stroke', '#f59e0b');
      trenchOutline.setAttribute('stroke-width', '2');
      trenchOutline.setAttribute('stroke-dasharray', '6,4');
      trenchGroup.appendChild(trenchOutline);

      viewportGroup.appendChild(trenchGroup);

      // --- D. DRAW PIPES & WATER LEVEL ---
      let pipeGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');

      // Calculate center X coordinates for each pipe barrel
      const startX = -totalPipesWidth / 2 + outerW / 2;

      for (let i = 0; i < numPipes; i++) {
        const cx = startX + i * (outerW + pipeSpacing);
        const pCx = toPxX(cx);

        if (currentShape === 'circular') {
          const cy = centerlineEl;
          const pCy = toPxY(cy);
          const rOut = toLen(outerW / 2);
          const rIn = toLen(innerW / 2);

          // Outer Concrete Circle
          const outerCircle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          outerCircle.setAttribute('cx', pCx);
          outerCircle.setAttribute('cy', pCy);
          outerCircle.setAttribute('r', rOut);
          outerCircle.setAttribute('fill', '#64748b');
          outerCircle.setAttribute('stroke', '#cbd5e1');
          outerCircle.setAttribute('stroke-width', '2');
          pipeGroup.appendChild(outerCircle);

          // Hatch on wall
          const hatchCircle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          hatchCircle.setAttribute('cx', pCx);
          hatchCircle.setAttribute('cy', pCy);
          hatchCircle.setAttribute('r', rOut);
          hatchCircle.setAttribute('fill', 'url(#pat_concrete)');
          pipeGroup.appendChild(hatchCircle);

          // Inner Hole Void Circle
          const innerCircle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          innerCircle.setAttribute('cx', pCx);
          innerCircle.setAttribute('cy', pCy);
          innerCircle.setAttribute('r', rIn);
          innerCircle.setAttribute('fill', '#0f172a'); // Interior void dark
          innerCircle.setAttribute('stroke', '#94a3b8');
          innerCircle.setAttribute('stroke-width', '1.5');
          pipeGroup.appendChild(innerCircle);

          // Water Layer Inside Circular Pipe centered strictly on (pCx, pCy)
          if (waterLevelPct > 0 && rIn > 0) {
            const clampedPct = Math.max(0, Math.min(100, waterLevelPct));
            const waterHWorld = (clampedPct / 100) * innerW;
            const waterYWorld = innerInvertEl + waterHWorld;
            const pWaterY = toPxY(waterYWorld);
            const pInnerInvertY = toPxY(innerInvertEl);
            const waterRectH = Math.max(0, pInnerInvertY - pWaterY);

            const clipId = `pipeClip_circ_${i}`;
            const clipPath = document.createElementNS('http://www.w3.org/2000/svg', 'clipPath');
            clipPath.setAttribute('id', clipId);
            const clipCircle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
            clipCircle.setAttribute('cx', pCx);
            clipCircle.setAttribute('cy', pCy);
            clipCircle.setAttribute('r', rIn);
            clipPath.appendChild(clipCircle);
            document.getElementById('svgDefs').appendChild(clipPath);

            const waterClippedGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
            waterClippedGroup.setAttribute('clip-path', `url(#${clipId})`);

            const waterRect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
            waterRect.setAttribute('x', pCx - rIn - 2);
            waterRect.setAttribute('y', pWaterY);
            waterRect.setAttribute('width', (rIn * 2) + 4);
            waterRect.setAttribute('height', waterRectH);
            waterRect.setAttribute('fill', '#0284c7');
            waterRect.setAttribute('opacity', '0.65');
            waterClippedGroup.appendChild(waterRect);

            // Water Surface Line centered on pCx
            const wLine = document.createElementNS('http://www.w3.org/2000/svg', 'line');
            wLine.setAttribute('x1', pCx - rIn);
            wLine.setAttribute('y1', pWaterY);
            wLine.setAttribute('x2', pCx + rIn);
            wLine.setAttribute('y2', pWaterY);
            wLine.setAttribute('stroke', '#38bdf8');
            wLine.setAttribute('stroke-width', '1.75');
            waterClippedGroup.appendChild(wLine);

            pipeGroup.appendChild(waterClippedGroup);
          }

          // Centerline Cross Marker
          const clGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
          clGroup.setAttribute('stroke', '#38bdf8');
          clGroup.setAttribute('stroke-width', '1');
          clGroup.setAttribute('stroke-dasharray', '5,3');
          clGroup.setAttribute('opacity', '0.6');

          const lineV = document.createElementNS('http://www.w3.org/2000/svg', 'line');
          lineV.setAttribute('x1', pCx); lineV.setAttribute('y1', pCy - rOut - 10);
          lineV.setAttribute('x2', pCx); lineV.setAttribute('y2', pCy + rOut + 10);

          const lineH = document.createElementNS('http://www.w3.org/2000/svg', 'line');
          lineH.setAttribute('x1', pCx - rOut - 10); lineH.setAttribute('y1', pCy);
          lineH.setAttribute('x2', pCx + rOut + 10); lineH.setAttribute('y2', pCy);

          clGroup.appendChild(lineV);
          clGroup.appendChild(lineH);
          pipeGroup.appendChild(clGroup);

        } else {
          // BOX CULVERT
          const pOuterX = toPxX(cx - outerW / 2);
          const pOuterY = toPxY(outerCrownEl);
          const pOuterW = toLen(outerW);
          const pOuterH = toLen(outerH);

          const pInnerX = toPxX(cx - innerW / 2);
          const pInnerY = toPxY(innerCrownEl);
          const pInnerW = toLen(innerW);
          const pInnerH = toLen(innerH);

          // Outer Box Rect
          const outerBox = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
          outerBox.setAttribute('x', pOuterX);
          outerBox.setAttribute('y', pOuterY);
          outerBox.setAttribute('width', pOuterW);
          outerBox.setAttribute('height', pOuterH);
          outerBox.setAttribute('fill', '#64748b');
          outerBox.setAttribute('stroke', '#cbd5e1');
          outerBox.setAttribute('stroke-width', '2');
          pipeGroup.appendChild(outerBox);

          // Box Concrete Hatch
          const hatchBox = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
          hatchBox.setAttribute('x', pOuterX);
          hatchBox.setAttribute('y', pOuterY);
          hatchBox.setAttribute('width', pOuterW);
          hatchBox.setAttribute('height', pOuterH);
          hatchBox.setAttribute('fill', 'url(#pat_concrete)');
          pipeGroup.appendChild(hatchBox);

          // Inner Void Box Rect
          const innerBox = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
          innerBox.setAttribute('x', pInnerX);
          innerBox.setAttribute('y', pInnerY);
          innerBox.setAttribute('width', pInnerW);
          innerBox.setAttribute('height', pInnerH);
          innerBox.setAttribute('fill', '#0f172a');
          innerBox.setAttribute('stroke', '#94a3b8');
          innerBox.setAttribute('stroke-width', '1.5');
          pipeGroup.appendChild(innerBox);

          // Water Level Inside Box Culvert centered strictly on pInnerX .. pInnerX + pInnerW
          if (waterLevelPct > 0 && pInnerH > 0) {
            const clampedPct = Math.max(0, Math.min(100, waterLevelPct));
            const waterHWorld = (clampedPct / 100) * innerH;
            const pWaterY = toPxY(innerInvertEl + waterHWorld);
            const pInnerInvertY = toPxY(innerInvertEl);
            const waterRectH = Math.max(0, pInnerInvertY - pWaterY);

            const clipId = `pipeClip_box_${i}`;
            const clipPath = document.createElementNS('http://www.w3.org/2000/svg', 'clipPath');
            clipPath.setAttribute('id', clipId);
            const clipRect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
            clipRect.setAttribute('x', pInnerX);
            clipRect.setAttribute('y', pInnerY);
            clipRect.setAttribute('width', pInnerW);
            clipRect.setAttribute('height', pInnerH);
            clipPath.appendChild(clipRect);
            document.getElementById('svgDefs').appendChild(clipPath);

            const waterClippedGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
            waterClippedGroup.setAttribute('clip-path', `url(#${clipId})`);

            const waterRect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
            waterRect.setAttribute('x', pInnerX);
            waterRect.setAttribute('y', pWaterY);
            waterRect.setAttribute('width', pInnerW);
            waterRect.setAttribute('height', waterRectH);
            waterRect.setAttribute('fill', '#0284c7');
            waterRect.setAttribute('opacity', '0.65');
            waterClippedGroup.appendChild(waterRect);

            // Water Surface Line aligned to inner box width
            const wLine = document.createElementNS('http://www.w3.org/2000/svg', 'line');
            wLine.setAttribute('x1', pInnerX);
            wLine.setAttribute('y1', pWaterY);
            wLine.setAttribute('x2', pInnerX + pInnerW);
            wLine.setAttribute('y2', pWaterY);
            wLine.setAttribute('stroke', '#38bdf8');
            wLine.setAttribute('stroke-width', '1.75');
            waterClippedGroup.appendChild(wLine);

            pipeGroup.appendChild(waterClippedGroup);
          }
        }
      }

      viewportGroup.appendChild(pipeGroup);

      // --- E. ELEVATION AXIS & CALLOUT MARKERS ---
      if (showCallouts) {
        let calloutGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');

        const axisLeftX = toPxX(minX + 0.5);

        // Axis Vertical Line
        const axisLine = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        axisLine.setAttribute('x1', axisLeftX);
        axisLine.setAttribute('y1', toPxY(groundEl + 0.3));
        axisLine.setAttribute('x2', axisLeftX);
        axisLine.setAttribute('y2', toPxY(bottomSoilEl));
        axisLine.setAttribute('stroke', '#94a3b8');
        axisLine.setAttribute('stroke-width', '2');
        calloutGroup.appendChild(axisLine);

        // Function to create standard elevation callout line & badge
        function drawElevationCallout(elev, labelText, colorClass, alignLeft = true) {
          const py = toPxY(elev);

          // Reference dash line across drawing
          const refLine = document.createElementNS('http://www.w3.org/2000/svg', 'line');
          refLine.setAttribute('x1', axisLeftX);
          refLine.setAttribute('y1', py);
          refLine.setAttribute('x2', toPxX(maxX - 0.5));
          refLine.setAttribute('y2', py);
          refLine.setAttribute('stroke', colorClass);
          refLine.setAttribute('stroke-width', '1');
          refLine.setAttribute('stroke-dasharray', '4,3');
          refLine.setAttribute('opacity', '0.7');
          calloutGroup.appendChild(refLine);

          // Marker triangle on axis
          const tri = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
          tri.setAttribute('points', `${axisLeftX},${py} ${axisLeftX-8},${py-5} ${axisLeftX-8},${py+5}`);
          tri.setAttribute('fill', colorClass);
          calloutGroup.appendChild(tri);

          // Text Label & Elevation Badge
          const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
          text.setAttribute('x', axisLeftX - 12);
          text.setAttribute('y', py + 4);
          text.setAttribute('fill', colorClass);
          text.setAttribute('font-size', '11');
          text.setAttribute('font-weight', 'bold');
          text.setAttribute('text-anchor', 'end');
          text.textContent = `${labelText} ${elev >= 0 ? '+' : ''}${formatElevationVal(elev, elevDec)} ม.`;
          calloutGroup.appendChild(text);
        }

        // Key Elevation Callouts
        drawElevationCallout(groundEl, 'ระดับผิวดิน Top Ground', '#f59e0b');
        drawElevationCallout(outerCrownEl, 'หลังท่อนอก Crown El.', '#60a5fa');
        drawElevationCallout(innerCrownEl, 'หลังท่อใน Soffit El.', '#cbd5e1');
        drawElevationCallout(centerlineEl, 'แกนท่อ Axis El.', '#a855f7');
        drawElevationCallout(innerInvertEl, 'ท้องท่อใน Invert El.', '#34d399');
        drawElevationCallout(outerInvertEl, 'ท้องท่อนอก Out Invert', '#94a3b8');
        drawElevationCallout(beddingBottomEl, 'ฐานรองท่อ Bedding Bot', '#f43f5e');

        viewportGroup.appendChild(calloutGroup);
      }

      // --- F. DIMENSION LINES (SOIL COVER & PIPE DIMENSIONS) ---
      if (showDimensions) {
        let dimGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');

        // 1. Soil Cover Depth Dimension Line (Vertical)
        const coverX = toPxX(totalPipesWidth / 2 + 0.8);
        const pGroundY = toPxY(groundEl);
        const pCrownY = toPxY(outerCrownEl);

        const dimLine = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        dimLine.setAttribute('x1', coverX); dimLine.setAttribute('y1', pGroundY);
        dimLine.setAttribute('x2', coverX); dimLine.setAttribute('y2', pCrownY);
        dimLine.setAttribute('stroke', '#38bdf8');
        dimLine.setAttribute('stroke-width', '1.5');
        dimGroup.appendChild(dimLine);

        // Arrows top & bottom
        function drawArrow(x, y, isUp) {
          const arrow = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
          const dy = isUp ? -6 : 6;
          arrow.setAttribute('points', `${x},${y} ${x-4},${y+dy} ${x+4},${y+dy}`);
          arrow.setAttribute('fill', '#38bdf8');
          dimGroup.appendChild(arrow);
        }
        drawArrow(coverX, pGroundY, false);
        drawArrow(coverX, pCrownY, true);

        // Text Badge
        const coverText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        coverText.setAttribute('x', coverX + 8);
        coverText.setAttribute('y', pGroundY + (pCrownY - pGroundY) / 2 + 4);
        coverText.setAttribute('fill', '#38bdf8');
        coverText.setAttribute('font-size', '11');
        coverText.setAttribute('font-weight', 'bold');
        coverText.textContent = `ดินถมหลังท่อ H = ${formatElevationVal(coverDepth, elevDec)} ม.`;
        dimGroup.appendChild(coverText);

        viewportGroup.appendChild(dimGroup);
      }

      // --- G. CROSSHAIR ELEMENTS FOR MOUSE INSPECTOR ---
      let inspectorGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      inspectorGroup.setAttribute('id', 'inspectorGroup');
      inspectorGroup.setAttribute('display', 'none');

      const chH = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      chH.setAttribute('id', 'crosshairH');
      chH.setAttribute('x1', 0); chH.setAttribute('x2', svgW);
      chH.setAttribute('stroke', '#38bdf8');
      chH.setAttribute('stroke-width', '1');
      chH.setAttribute('stroke-dasharray', '3,3');
      inspectorGroup.appendChild(chH);

      const chV = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      chV.setAttribute('id', 'crosshairV');
      chV.setAttribute('y1', 0); chV.setAttribute('y2', svgH);
      chV.setAttribute('stroke', '#38bdf8');
      chV.setAttribute('stroke-width', '1');
      chV.setAttribute('stroke-dasharray', '3,3');
      inspectorGroup.appendChild(chV);

      const chDot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      chDot.setAttribute('id', 'crosshairDot');
      chDot.setAttribute('r', '4');
      chDot.setAttribute('fill', '#38bdf8');
      chDot.setAttribute('stroke', '#ffffff');
      chDot.setAttribute('stroke-width', '1.5');
      inspectorGroup.appendChild(chDot);

      viewportGroup.appendChild(inspectorGroup);
    }

    // --- INTERACTIVE MOUSE & TOUCH INSPECTOR LOGIC ---
    function setupInteractiveEvents() {
      const container = document.getElementById('svgContainer');
      const hud = document.getElementById('inspectorHUD');

      container.addEventListener('mousemove', (e) => {
        const rect = container.getBoundingClientRect();
        const mouseX = e.clientX - rect.left;
        const mouseY = e.clientY - rect.top;

        if (isDragging) {
          panX += (e.clientX - dragStartX);
          panY += (e.clientY - dragStartY);
          dragStartX = e.clientX;
          dragStartY = e.clientY;
          updateDraw();
          return;
        }

        if (!currentCalcState) return;

        // Calculate world coordinates from mouse position
        const worldX = currentCalcState.fromPxX(mouseX);
        const worldY = currentCalcState.fromPxY(mouseY);
        const depth = currentCalcState.groundEl - worldY;

        // Update Crosshair Lines
        const inspectorGroup = document.getElementById('inspectorGroup');
        const chH = document.getElementById('crosshairH');
        const chV = document.getElementById('crosshairV');
        const chDot = document.getElementById('crosshairDot');

        if (inspectorGroup) {
          inspectorGroup.setAttribute('display', 'block');
          chH.setAttribute('y1', mouseY); chH.setAttribute('y2', mouseY);
          chV.setAttribute('x1', mouseX); chV.setAttribute('x2', mouseX);
          chDot.setAttribute('cx', mouseX); chDot.setAttribute('cy', mouseY);
        }

        // Determine Layer / Region under Cursor
        let layerName = 'เหนือผิวดิน (Above Ground)';
        if (depth >= 0) {
          let accumDepth = 0;
          let found = false;

          for (let l of soilLayers) {
            accumDepth += l.thickness;
            if (depth <= accumDepth) {
              layerName = l.name;
              found = true;
              break;
            }
          }
          if (!found) layerName = 'ชั้นดินฐานราก (Deep Subsoil)';
        }

        // Check if cursor is inside pipe
        if (worldY <= currentCalcState.outerCrownEl && worldY >= currentCalcState.outerInvertEl) {
          const startX = -currentCalcState.totalPipesWidth / 2 + currentCalcState.outerW / 2;
          for (let i = 0; i < currentCalcState.numPipes; i++) {
            const cx = startX + i * (currentCalcState.outerW + currentCalcState.pipeSpacing);
            const dist = Math.abs(worldX - cx);
            if (dist <= currentCalcState.outerW / 2) {
              if (worldY <= currentCalcState.innerCrownEl && worldY >= currentCalcState.innerInvertEl && dist <= currentCalcState.innerW / 2) {
                layerName = 'ภายในท่อ (Pipe Interior Void)';
              } else {
                layerName = 'ผนังท่อคอนกรีต (Concrete Wall)';
              }
            }
          }
        }

        // Check if cursor is in bedding layer
        if (worldY < currentCalcState.outerInvertEl && worldY >= currentCalcState.beddingBottomEl) {
          if (Math.abs(worldX) <= currentCalcState.totalPipesWidth / 2 + 0.5) {
            layerName = 'ชั้นวัสดุรองพื้นท่อ (Pipe Bedding Layer)';
          }
        }

        // Update HUD display text
        const d = currentCalcState.elevDec || 2;
        hud.classList.remove('hidden');
        document.getElementById('hudElev').innerText = `${worldY >= 0 ? '+' : ''}${formatElevationVal(worldY, d)} m MSL`;
        document.getElementById('hudDepth').innerText = `${formatElevationVal(depth, d)} m`;
        document.getElementById('hudDistX').innerText = `${formatElevationVal(worldX, d)} m`;
        document.getElementById('hudLayerType').innerText = layerName;
      });

      container.addEventListener('mouseleave', () => {
        const inspectorGroup = document.getElementById('inspectorGroup');
        if (inspectorGroup) inspectorGroup.setAttribute('display', 'none');
        hud.classList.add('hidden');
        isDragging = false;
      });

      // Pan & Drag Functionality
      container.addEventListener('mousedown', (e) => {
        if (e.button === 0) { // Left click
          isDragging = true;
          dragStartX = e.clientX;
          dragStartY = e.clientY;
        }
      });

      container.addEventListener('mouseup', () => {
        isDragging = false;
      });

      // Mouse Wheel Zoom
      container.addEventListener('wheel', (e) => {
        e.preventDefault();
        if (e.deltaY < 0) {
          zoomIn();
        } else {
          zoomOut();
        }
      }, { passive: false });
    }

    // --- INITIALIZE APPLICATION ---
    window.addEventListener('DOMContentLoaded', () => {
      initSVGPatterns();
      renderSoilLayersList();
      setupInteractiveEvents();
      setSyncMode(syncMode);
      updateDraw();
    });

    // --- ZOOM CONTROLS ---
    function zoomIn() {
      zoomLevel = Math.min(zoomLevel * 1.2, 4.0);
      updateDraw();
    }

    function zoomOut() {
      zoomLevel = Math.max(zoomLevel / 1.2, 0.4);
      updateDraw();
    }

    function resetZoom() {
      zoomLevel = 1.0;
      panX = 0;
      panY = 0;
      updateDraw();
      showToast('รีเซ็ตมุมมองเรียบร้อย', 'info');
    }

    // --- EXPORT FUNCTIONALITIES ---
    function exportSVG() {
      const svg = document.getElementById('mainSVG');
      const serializer = new XMLSerializer();
      let source = serializer.serializeToString(svg);
      
      if (!source.match(/^<svg[^>]+xmlns="http\:\/\/www\.w3\.org\/2000\/svg"/)) {
        source = source.replace(/^<svg/, '<svg xmlns="http://www.w3.org/2000/svg"');
      }

      const blob = new Blob([source], { type: 'image/svg+xml;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `pipe_cross_section_${Date.now()}.svg`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast('ส่งออกไฟล์ SVG สำเร็จ', 'success');
    }

    function exportPNG() {
      const svg = document.getElementById('mainSVG');
      const serializer = new XMLSerializer();
      const svgString = serializer.serializeToString(svg);

      const canvas = document.createElement('canvas');
      const rect = document.getElementById('svgContainer').getBoundingClientRect();
      canvas.width = rect.width * 2; // High DPI 2x scale
      canvas.height = rect.height * 2;
      const ctx = canvas.getContext('2d');

      const img = new Image();
      const svgBlob = new Blob([svgString], { type: 'image/svg+xml;charset=utf-8' });
      const url = URL.createObjectURL(svgBlob);

      img.onload = function () {
        ctx.fillStyle = '#0f172a'; // CAD Dark Background
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

        const pngUrl = canvas.toDataURL('image/png');
        const link = document.createElement('a');
        link.href = pngUrl;
        link.download = `pipe_cross_section_${Date.now()}.png`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);
        showToast('ส่งออกภาพ PNG ความละเอียดสูงสำเร็จ', 'success');
      };

      img.src = url;
    }

    // --- TOAST NOTIFICATIONS ---
    function showToast(msg, type = 'info') {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      
      let bg = 'bg-slate-800 border-slate-700 text-slate-200';
      let icon = 'fa-info-circle text-blue-400';
      if (type === 'success') {
        bg = 'bg-slate-800 border-emerald-500/50 text-emerald-200';
        icon = 'fa-circle-check text-emerald-400';
      } else if (type === 'error') {
        bg = 'bg-slate-800 border-rose-500/50 text-rose-200';
        icon = 'fa-triangle-exclamation text-rose-400';
      }

      toast.className = `flex items-center space-x-2 border text-xs px-3.5 py-2.5 rounded-xl shadow-2xl backdrop-blur transition-all transform translate-y-2 opacity-0 ${bg}`;
      toast.innerHTML = `<i class="fa-solid ${icon}"></i> <span>${msg}</span>`;

      container.appendChild(toast);

      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      });

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 3000);
    }

    // Recalculate layout on window resize
    window.addEventListener('resize', () => {
      updateDraw();
    });
  </script>
